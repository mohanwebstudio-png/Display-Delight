# ── DisplayDelight V3 Platform — Root Environment Template ─────────────────────
# Copy this file to .env in production/staging environments.
# NEVER commit real credentials, secret keys, or live payment credentials.

# ── Application Environment ───────────────────────────────────────────────────
APP_NAME="DisplayDelight V3"
APP_ENV=development              # development | staging | production
DEBUG=true
PORT=8443
VITE_API_URL=http://localhost:8000/api/v1

# ── Security & Authentication ─────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_RANDOM_KEY
AUTH_SECRET_KEY=REPLACE_WITH_SECURE_AUTH_SECRET_KEY
ENCRYPTION_KEY=REPLACE_WITH_SECURE_32_BYTE_BASE64_KEY

# ── Origins & Routing ─────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:8443
ADMIN_SITE_URL=http://localhost:8443/admin
API_BASE_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: sqlite:///./displaydelight.db
# Staging/Production: postgresql+psycopg2://user:password@localhost:5432/displaydelight
DATABASE_URL=sqlite:///./displaydelight.db
REDIS_URL=redis://localhost:6379/0

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
RAZORPAY_MODE=test               # test | live
RAZORPAY_KEY_ID=rzp_test_displaydelight
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholder
RAZORPAY_CURRENCY=INR

# ── Transactional SMTP / Email ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=notifications@displaydelight.in
SMTP_PASSWORD=PLACEHOLDER_SMTP_PASSWORD
EMAIL_FROM_NAME="DisplayDelight Orders"
EMAIL_FROM_ADDRESS=notifications@displaydelight.in

# ── Cloudflare Media & Storage (Optional) ─────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_BUCKET=displaydelight-media
CLOUDFLARE_IMAGES_HASH=
CLOUDFLARE_STREAM_TOKEN=
OBJECT_STORAGE_PROVIDER=server   # server | cloudflare_r2

# ── Push Notifications / FCM ──────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_SERVER_CREDENTIALS_SECRET_REF=

# ── Business & Taxation ───────────────────────────────────────────────────────
DEFAULT_GST_RATE=18
COMPANY_GSTIN=29AABCD1234E1ZK
COMPANY_NAME="DisplayDelight Pvt Ltd"
COMPANY_ADDRESS="Plot 42, Electronics City, Bengaluru, Karnataka 560100"
