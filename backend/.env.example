# ── DisplayDelight V2 Backend — Environment Variables ──────────────────────────
# Copy to .env and fill in real values. Never commit the real .env.

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="DisplayDelight V2"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ── Database (PostgreSQL) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/displaydelight
# For async/test override:
# DATABASE_URL=sqlite:///./test.db

# ── CORS / Frontend ─────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:8443
ALLOWED_ORIGINS=http://localhost:8443,http://localhost:5173

# ── JWT Auth ────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── File Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_ARTWORK_SIZE_MB=20
ALLOWED_ARTWORK_TYPES=image/jpeg,image/png,image/webp,image/svg+xml,application/pdf

# ── Razorpay ────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_SECRET
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET
RAZORPAY_CURRENCY=INR

# ── SMTP / Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=notifications@displaydelight.in
SMTP_PASSWORD=PLACEHOLDER_SMTP_PASSWORD
EMAIL_FROM_NAME="DisplayDelight"
EMAIL_FROM_ADDRESS=notifications@displaydelight.in

# ── Cloudflare (optional) ───────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=PLACEHOLDER
CLOUDFLARE_API_TOKEN=PLACEHOLDER
CLOUDFLARE_R2_BUCKET=displaydelight-media
CLOUDFLARE_IMAGES_HASH=PLACEHOLDER
CLOUDFLARE_STREAM_TOKEN=PLACEHOLDER

# ── WhatsApp (optional) ─────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_TOKEN=PLACEHOLDER
WHATSAPP_PHONE_NUMBER_ID=PLACEHOLDER

# ── GST / Business ──────────────────────────────────────────────────────────────
DEFAULT_GST_RATE=18
COMPANY_GSTIN=29AABCD1234E1ZK
COMPANY_NAME="DisplayDelight Pvt Ltd"
COMPANY_ADDRESS="Bangalore, Karnataka, India"

# ── Shipping ────────────────────────────────────────────────────────────────────
DEFAULT_SHIPPING_CHARGE=600
FREE_SHIPPING_ABOVE=50000

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Redis (optional caching) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
